# ===== MySQL =====
# رمز کاربر root دیتابیس، حتماً عوض کن
MYSQL_ROOT_PASSWORD=changeme
# اسم دیتابیسی که موقع بالا اومدن اولین بار خودکار ساخته میشه
MYSQL_DATABASE=app
# مقدار RAM ای که MySQL برای کش کردن دیتا/ایندکس‌ها تو حافظه نگه می‌داره
# مهم‌ترین تنظیم پرفورمنسه، حدود ۵۰-۷۰٪ رمی که می‌خوای به MySQL بدی
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
# سقف تعداد کانکشن همزمان به دیتابیس (هر کانکشن یه‌کم RAM جدا می‌گیره)
MYSQL_MAX_CONNECTIONS=100
# binlog یعنی لاگ کردن هر تغییر دیتابیس، برای replication و point-in-time recovery لازمه
# ولی اگه نیازش نداری فقط فضای دیسک اضافه می‌گیره. برای خاموش کردنش یه مقدار غیرخالی بذار (مثلاً 1)
# برای روشن نگه‌داشتنش (پیش‌فرض MySQL 8) این خط رو خالی بذار
MYSQL_DISABLE_BINLOG=

# ===== Postgres =====
# رمز کاربر postgres، حتماً عوض کن
POSTGRES_PASSWORD=changeme
# اسم دیتابیسی که موقع بالا اومدن اولین بار خودکار ساخته میشه
POSTGRES_DB=app
# حافظه‌ای که خود Postgres برای کش داخلیش نگه می‌داره، حدود ۲۵٪ رمی که بهش می‌دی
POSTGRES_SHARED_BUFFERS=256MB
# تخمینی که Postgres از حجم کش OS (فایل‌سیستم) داره، فقط برای برنامه‌ریزی query planner استفاده میشه
# نه یه حافظه‌ی واقعی جدا، حدود ۵۰-۷۵٪ رمی که به این سرور می‌دی
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
# سقف تعداد کانکشن همزمان
POSTGRES_MAX_CONNECTIONS=100

# ===== Typesense =====
# کلید API که برای هر request به Typesense لازمه، حتماً عوض کن و جایی امن نگهش دار
TYPESENSE_API_KEY=changeme

# ===== Redis =====
# رمزی که برای وصل شدن به Redis لازمه (با AUTH)
REDIS_PASSWORD=changeme
# سقف حافظه‌ای که Redis اجازه داره مصرف کنه، بدون این مقدار Redis می‌تونه کل RAM سرور رو بخوره
REDIS_MAXMEMORY=256mb
# وقتی به سقف بالا رسید چیکار کنه: allkeys-lru یعنی قدیمی‌ترین کلیدهای استفاده‌نشده رو حذف کن
# (مناسب برای cache؛ اگه Redis رو به‌عنوان دیتابیس اصلی/صف کار استفاده می‌کنی این گزینه رو با noeviction عوض کن)
REDIS_MAXMEMORY_POLICY=allkeys-lru
# یوزر/پسورد Basic Auth برای ورود به پنل وب redis-commander، حتماً عوض کن
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=changeme

# ===== Deploy user =====
# یوزری که پروژه‌ها روی سرور توش دیپلوی میشن، با UID/GID ثابت 1000 ساخته میشه
# (چون همه‌ی دایرکتوری‌های پروژه رو معمولاً با این یوزر می‌سازی)
# اگه از قبل یوزری با UID 1000 وجود داشته باشه، این تنظیم نادیده گرفته میشه
DEPLOY_USER=deploy

# ===== pgAdmin =====
# ایمیل و رمز ورود به پنل pgAdmin، حتماً عوض کن
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# ===== MongoDB =====
# یوزر/رمز روت مونگو
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
# یوزر/پسورد Basic Auth برای ورود به پنل وب mongo-express، حتماً عوض کن
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=changeme
